{
    "name": "objective-rental-api",
    "version": "1.0.0",
    "description": "API para locação de filmes - Objective",
    "main": "dist/main.js",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/main.js",
        "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/main.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:int": "jest --config jest-integration.config.ts"
    },
    "dependencies": {
        "express": "^4.18.2",
        "mongodb": "^6.3.0",
        "dotenv": "^16.3.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/node": "^20.10.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.1",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.3.2"
    }
}