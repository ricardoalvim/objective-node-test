{
    "name": "objective-rental-api",
    "version": "1.0.0",
    "description": "API para locação de filmes - Objective",
    "main": "dist/main.js",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "tsoa": "tsoa spec",
        "build": "tsoa spec && tsc",
        "start": "node dist/main.js",
        "dev": "concurrently \"nodemon\" \"nodemon -x tsoa spec\"",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
    },
    "dependencies": {
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "module-alias": "^2.3.4",
        "mongodb": "^6.3.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "tsoa": "^7.0.0-alpha.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/module-alias": "^2.0.4",
        "@types/node": "^20.10.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "concurrently": "^9.2.1",
        "jest": "^29.7.0",
        "prettier": "3.8.1",
        "ts-jest": "^29.1.1",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.3.2"
    },
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": [
            "node",
            "jest"
        ]
    },
    "_moduleAliases": {
        "@shared": "dist/shared",
        "@modules": "dist/modules"
    }
}