{
    "name": "objective-rental-api",
    "version": "1.0.0",
    "scripts": {
        "tsoa": "tsoa spec",
        "build": "tsoa spec && tsc",
        "start": "node dist/main.js",
        "dev": "concurrently \"ts-node-dev -r tsconfig-paths/register src/main.ts\" \"nodemon -x tsoa spec\"",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "dependencies": {
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "module-alias": "^2.3.4",
        "mongodb": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "tsoa": "^6.0.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/module-alias": "^2.0.4",
        "@types/node": "^20.10.0",
        "@types/supertest": "^6.0.3",
        "@types/swagger-ui-express": "^4.1.8",
        "concurrently": "^9.2.1",
        "jest": "^29.7.0",
        "mongodb-memory-server": "^11.0.1",
        "prettier": "3.1.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.1.1",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.3.2"
    },
    "_moduleAliases": {
        "@shared": "dist/shared",
        "@modules": "dist/modules"
    }
}
